#!/bin/sh
"""exec" /bin/sh "$(dirname "$0")/evaluation/launch.sh" "$0" "$@"
"""


import sys

COMMANDS = {
    "simple": "Run a credential-free baseline against a released task",
    "serve": "Browse local rankings, trial trajectories and exports",
    "specs": "Validate and inspect task categories, background and instruction profiles",
    "build": "Build standalone Harbor tasks from archived games",
    "report": "Rebuild readable run reports and link native trajectories offline",
    "e2e": "Evaluate one native CLI and model on a release selection",
    "boundary": "Probe the isolated CLI workers on the two KC–T1 game-two snapshots",
    "init-game": "Create an editable lobby or ordered BP observation form",
    "freeze": "Create a label-free task from an observed lobby or draft",
    "forecast": "Run an isolated CLI on an unlabeled task and seal its prediction",
    "submit": "Record the first forecast for an entrant on a trusted clock",
    "close": "Seal a stage at its first public BP action or game start",
    "settle": "Attach a published result to an immutable observation",
    "scores": "View eligible receipts for one settled observation",
    "history-add": "Import a completed game as dated historical evidence",
    "release": "Package scored tasks with a reproducible manifest",
    "export": "Export a release as chronological RL and evaluation datasets",
    "validate-pack": "Validate contributors' versioned player evidence packs",
}

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print("LoL Competition Bench · operator commands\n\n  ./bench COMMAND --help\n")
    for k, v in COMMANDS.items():
        print(f"  {k:9} {v}")
    sys.exit()
cmd = sys.argv[1]
if cmd not in COMMANDS:
    sys.exit(f"Unknown command: {cmd}")
try:
    if cmd in ("simple", "e2e"):
        from evaluation.suite import main

        del sys.argv[1]
        main(simple=cmd == "simple")
    elif cmd == "specs":
        from production.specs import main

        del sys.argv[1]
        main()
    elif cmd == "build":
        from production.build import main

        del sys.argv[1]
        main()
    elif cmd == "serve":
        from evaluation.site import main

        del sys.argv[1]
        main()
    elif cmd == "report":
        from evaluation.traces import main

        del sys.argv[1]
        main()
    elif cmd == "boundary":
        from evaluation.cli.boundary import main

        del sys.argv[1]
        main()
    elif cmd == "forecast":
        from evaluation.pending import main

        del sys.argv[1]
        main()
    elif cmd == "validate-pack":
        from production.evidence import main

        del sys.argv[1]
        main()
    elif cmd == "export":
        from production.export import main

        del sys.argv[1]
        main()
    elif cmd == "release":
        from production.release import main

        del sys.argv[1]
        main()
    else:
        from production.intake import main

        main()
except (ValueError, OSError, KeyError) as e:
    sys.exit(str(e))
